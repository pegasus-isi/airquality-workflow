FROM python:3.8.12-slim

# Install system dependencies
RUN apt-get update && \
    apt-get install -y \
        git \
        wget \
        curl \
        build-essential \
        && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN pip install --upgrade pip setuptools wheel

# Install Python dependencies for air quality analysis and ML
# Base dependencies (from original container)
RUN pip install --no-cache-dir \
    pandas \
    numpy \
    matplotlib \
    scipy \
    requests \
    pytz \
    sage-data-client

# ML dependencies for forecasting
RUN pip install --no-cache-dir \
    torch \
    scikit-learn \
    tqdm

# Set working directory
WORKDIR /app

# Default command
CMD ["/bin/bash"]
